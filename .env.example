# Copy to `.env` at the repository root and fill in real values.
# `.env` is gitignored; this template is committed, so EVERY VALUE HERE IS A
# PLACEHOLDER. A template that ships a real hostname is the specific failure
# where a file designed to be safe becomes the leak.
#
# A real OS environment variable always wins over this file.

# ---- FactSet SQL Server ------------------------------------------------------
# No code defaults exist for these three; a missing value fails loudly at
# connection time rather than silently connecting somewhere unintended.
FACTSET_SQL_SERVER=<host-or-ip>
FACTSET_SQL_DATABASE=<database-name>
FACTSET_SQL_USER=<username>
FACTSET_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Leave FACTSET_SQL_PASSWORD UNSET. You are then prompted via getpass, and the
# password never touches disk or shell history. Setting it here works, but it
# puts a live credential in a file on a machine you may not always control.
# FACTSET_SQL_PASSWORD=

# ---- Where the data lives ----------------------------------------------------
# MUST be outside this repository: the data is licensed and non-redistributable,
# and ~1.4 GB inside a git working tree is a standing risk.
# Defaults to ~/statarb-data if unset.
FACTSET_DEST_ROOT=~/statarb-data

# ---- Extraction window -------------------------------------------------------
FACTSET_START_DATE=1995-01-01
FACTSET_END_DATE=2050-12-31

# Set once discovery has confirmed the feed's real max date; bounds the shard
# list so it does not generate empty future-year shards.
# FACTSET_FEED_MAX_YEAR=2026
